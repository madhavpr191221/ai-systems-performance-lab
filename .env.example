# App launch configuration. Run with: uv run --env-file .env lab
LAB_API_HOST=127.0.0.1
LAB_API_PORT=8003
LAB_UI_HOST=127.0.0.1
LAB_UI_PORT=5174
VITE_API_URL=http://127.0.0.1:8003
LAB_CONCURRENCY=2
LAB_QUEUE_CAPACITY=4
LAB_TOOL_DELAY_MS=20
LAB_MODEL_DELAY_MS=30

# Agent mode and AWS settings. Keep credentials out of this file; use an AWS CLI profile.
AGENT_BACKEND=simulated
AWS_PROFILE=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
DYNAMODB_CASES_TABLE=
AWS_DATA_BUCKET=
AGENT_SESSION_S3_BUCKET=
SYNTHETIC_CASE_COUNT=1000
SYNTHETIC_SEED=20261117

# To opt into Bedrock, set AGENT_BACKEND=bedrock and provide an accessible model ID.
# Authentication uses the standard AWS SDK credential chain.
# POLICY_S3_KEY=policies/synthetic-review-v1.txt
# BEDROCK_MAX_TOKENS=1200
# AGENT_MAX_OUTPUT_TOKENS=900
# AGENT_MAX_MODEL_TURNS=6
# AGENT_MAX_TOOL_CALLS=8
# AGENT_MAX_REQUESTS_PER_PROCESS=5  # request-count guard, not a dollar cap
# AGENT_REQUEST_TIMEOUT_SECONDS=180
# BEDROCK_READ_TIMEOUT_SECONDS=60

# Optional case-scoped AgentCore Memory. Create the resource and configure its
# namespace strategy before enabling it. This is memory, not a source of case facts.
# AGENTCORE_MEMORY_ID=
# AGENTCORE_MEMORY_NAMESPACE=case/{actorId}/reviews
# AGENT_SESSION_PREFIX=agent-sessions
